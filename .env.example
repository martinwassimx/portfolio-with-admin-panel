# ========================================================
# PORTFOLIO WITH ADMIN PANEL - ENVIRONMENT VARIABLES
# ========================================================

# Supabase Project URL (from your Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER ONLY, NEVER COMMIT OR EXPOSE TO CLIENT)
# Optional: used only for administrative bypass if configured
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production Site URL (for SEO canonical links, sitemaps, and social share cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional External AI API Keys (for CV Auto-Fill 2.0 Generative AI Enhancement)
# If omitted, the engine uses the high-precision built-in heuristic synthesis model
GEMINI_API_KEY=
OPENAI_API_KEY=
